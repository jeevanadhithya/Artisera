# ─── Supabase Configuration ───
SUPABASE_URL=https://your-supabase-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:your-password@db.your-supabase-ref.supabase.co:5432/postgres
# Note: If your local network does not support IPv6, use the Connection Pooler endpoint on port 6543 instead:
# DATABASE_URL=postgresql://postgres.your-supabase-ref:your-password@aws-0-[region].pooler.supabase.com:6543/postgres

# ─── Backend API Settings ───
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,https://artisera-frontend.vercel.app

# ─── AI Providers (Server-Side Only) ───
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# ─── Sarvam AI (Speech-to-Text & Translation) ───
SARVAM_API_KEY=your-sarvam-api-key
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_SPEECH_MODEL=saaras:v3
SARVAM_SPEECH_MODE=transcribe
SARVAM_TRANSLATION_MODEL=mayura:v1

# ─── Storage Buckets ───
STORAGE_BUCKET_PRODUCTS=product-images
STORAGE_BUCKET_VOICES=voice-recordings

# ─── Image Enhancement AI (AWS EC2 Primary + RemoveBG Fallback) ───
IMAGE_AI_URL=http://13.63.125.7:8000
IMAGE_AI_BACKUP=remove_bg
IMAGE_AI_TIMEOUT_MS=30000
REMOVE_BG_API_KEY=your-remove-bg-api-key
