# ==============================================================================
# ARTISERA CONFIGURATION TEMPLATE
# Smart India Hackathon 2026 | PS-26090
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file or production secret keys to version control.
# ==============================================================================

# ─── Server Configuration ─────────────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# ─── Database & Auth (Supabase / PostgreSQL) ──────────────────────────────────
# Client-Safe: SUPABASE_URL and SUPABASE_ANON_KEY can be used in client apps.
# Server-Only: SUPABASE_SERVICE_ROLE_KEY & DATABASE_URL must NEVER be exposed to clients.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-public-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-private-service-role-key-here
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# Supabase Storage Buckets
STORAGE_BUCKET_PRODUCTS=product-images
STORAGE_BUCKET_VOICES=voice-recordings

# ─── Multimodal AI Services (Gemini / Qwen) ───────────────────────────────────
# Server-Only: API keys are used strictly on the Node.js backend.
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-google-ai-studio-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Optional: Private vLLM Endpoint on GPU Instance (e.g. AWS EC2 G5.xlarge)
VLLM_BASE_URL=http://your-gpu-instance-ip:8000
VLLM_API_KEY=your-vllm-bearer-token

# ─── Indic Speech & Translation AI (Sarvam AI) ────────────────────────────────
# Server-Only: Used for speech-to-text transcription and audio playback in 7 Indic languages.
SARVAM_API_KEY=your-sarvam-ai-api-key
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_SPEECH_MODEL=saaras:v3
SARVAM_SPEECH_MODE=transcribe
SARVAM_TRANSLATION_MODEL=mayura:v1

# ─── Computer Vision & Image AI Microservice ──────────────────────────────────
# URL to the BiRefNet-HR FastAPI image studio service (AI_Models/app.py)
IMAGE_AI_URL=http://localhost:8000
IMAGE_AI_TIMEOUT_MS=30000
ENHANCE_MAX_DIMENSION=1200
ENHANCE_JPEG_QUALITY=92
ENHANCE_SHARPEN_AMOUNT=1.2

# Optional Image Fallbacks
REMOVE_BG_API_KEY=
CV_WORKER_URL=http://localhost:8001

# ─── File Upload Limits ────────────────────────────────────────────────────────
MAX_IMAGE_SIZE_MB=10
MAX_AUDIO_SIZE_MB=25
